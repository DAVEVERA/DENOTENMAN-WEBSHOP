enum BusinessOrderListStatus {
  DRAFT
  SENT
  CHANGES_REQUESTED
  APPROVED
  CANCELLED
}

enum BusinessActorType {
  ADMIN
  CUSTOMER
  SYSTEM
}

enum BusinessEventType {
  ACCOUNT_CREATED
  ACCOUNT_UPDATED
  INVITATION_SENT
  PORTAL_LOGIN
  ORDER_LIST_CREATED
  ORDER_LIST_SENT
  ORDER_LIST_QUANTITIES_CHANGED
  ORDER_LIST_NOTE_ADDED
  ORDER_LIST_APPROVED
  ORDER_LIST_CHANGES_REQUESTED
  ORDER_LIST_CANCELLED
}

model BusinessInvitation {
  id                String          @id @default(cuid())
  businessAccountId String
  businessAccount   BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  email             String
  tokenHash         String          @unique
  expiresAt         DateTime
  acceptedAt        DateTime?
  revokedAt         DateTime?
  deliveryStatus    String          @default("PENDING")
  providerMessageId String?
  deliveryError     String?
  createdByAdminId  String?
  createdByAdmin    AdminUser?      @relation("BusinessInvitationCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())

  @@index([businessAccountId, createdAt])
  @@index([email, expiresAt])
}

model BusinessSession {
  id                String          @id @default(cuid())
  businessAccountId String
  businessAccount   BusinessAccount @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  tokenHash         String          @unique
  expiresAt         DateTime
  lastSeenAt        DateTime        @default(now())
  revokedAt         DateTime?
  createdAt         DateTime        @default(now())

  @@index([businessAccountId, expiresAt])
  @@index([expiresAt])
}

model BusinessOrderList {
  id                String                  @id @default(cuid())
  businessAccountId String
  businessAccount   BusinessAccount         @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  title             String
  status            BusinessOrderListStatus @default(DRAFT)
  version           Int                     @default(1)
  totalCents        Int
  validUntil        DateTime?
  sentAt            DateTime?
  approvedAt        DateTime?
  deliveryStatus    String                  @default("NONE")
  providerMessageId String?
  deliveryError     String?
  createdByAdminId  String
  createdByAdmin    AdminUser               @relation("BusinessOrderListCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  items  BusinessOrderListItem[]
  notes  BusinessOrderListNote[]
  events BusinessEvent[]

  @@index([businessAccountId, createdAt])
  @@index([status, updatedAt])
}

model BusinessOrderListItem {
  id               String            @id @default(cuid())
  orderListId      String
  orderList        BusinessOrderList @relation(fields: [orderListId], references: [id], onDelete: Cascade)
  productVariantId String?
  productVariant   ProductVariant?   @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  productName      String
  variantLabel     String?
  sku              String?
  quantity         Int
  unitPriceCents   Int
  sortOrder        Int               @default(0)

  @@index([orderListId, sortOrder])
  @@index([productVariantId])
}

model BusinessOrderListNote {
  id          String            @id @default(cuid())
  orderListId String
  orderList   BusinessOrderList @relation(fields: [orderListId], references: [id], onDelete: Cascade)
  actorType   BusinessActorType
  authorName  String
  text        String            @db.Text
  createdAt   DateTime          @default(now())

  @@index([orderListId, createdAt])
}

model BusinessEvent {
  id                String              @id @default(cuid())
  businessAccountId String
  businessAccount   BusinessAccount     @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  orderListId       String?
  orderList         BusinessOrderList?  @relation(fields: [orderListId], references: [id], onDelete: Cascade)
  type              BusinessEventType
  actorType         BusinessActorType
  actorName         String
  summary           String
  metadata          Json?
  createdAt         DateTime            @default(now())
  reads             BusinessEventRead[]

  @@index([businessAccountId, createdAt])
  @@index([orderListId, createdAt])
}

model BusinessEventRead {
  businessEventId String
  businessEvent   BusinessEvent @relation(fields: [businessEventId], references: [id], onDelete: Cascade)
  adminUserId     String
  adminUser       AdminUser     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  readAt          DateTime      @default(now())

  @@id([businessEventId, adminUserId])
  @@index([adminUserId, readAt])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

model Quote {
  id                String          @id @default(cuid())
  businessAccountId String
  businessAccount   BusinessAccount @relation(fields: [businessAccountId], references: [id])
  status            QuoteStatus     @default(DRAFT)
  items             Json
  totalCents        Int
  validUntil        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([businessAccountId])
}
