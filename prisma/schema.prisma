enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

// Generic before/after snapshot log for every admin mutation. entityType is
// the Prisma model name (e.g. "Product", "QrCodeDesign"); entityId is that
// model's id as a string. Reverting replays `before` and writes a new
// RESTORE entry rather than mutating history in place.
model AuditLog {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  adminUserId String
  adminUser   AdminUser   @relation(fields: [adminUserId], references: [id])
  action      AuditAction
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  reverted    Boolean     @default(false)
  revertOfId  String?

  @@index([entityType, entityId])
  @@index([adminUserId])
  @@index([createdAt])
}

