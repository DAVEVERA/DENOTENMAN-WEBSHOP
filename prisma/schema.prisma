generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  nl
  en
  fr
}

enum CategoryType {
  STANDARD
  PROMOTIONAL
}

enum Preparation {
  RAW
  ROASTED
}

enum Salting {
  UNSALTED
  SALTED
}

enum Coating {
  NONE
  CHOCOLATE
  YOGHURT
  FLAVORED
}

enum MeasurementUnit {
  WEIGHT
  VOLUME
}

enum Role {
  OWNER
  ADMIN
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum DeliveryMethod {
  SHIPPING
  PICKUP
}

enum CompositionSource {
  TEXT
  VOICE
}

enum StockNotificationStatus {
  PENDING
  SENT
  CANCELLED
}

enum GoogleAdsStatus {
  DRAFT
  ENABLED
  PAUSED
  ERROR
}

model Category {
  id        String       @id @default(cuid())
  slug      String       @unique
  type      CategoryType @default(STANDARD)
  parentId  String?
  parent    Category?    @relation("CategoryToChildren", fields: [parentId], references: [id])
  children  Category[]   @relation("CategoryToChildren")
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  translations      CategoryTranslation[]
  productCategories ProductCategory[]

  @@index([parentId])
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  locale      Locale
  name        String
  slug        String
  description String?

  @@unique([categoryId, locale])
  @@unique([locale, slug])
}

model Product {
  id             String          @id @default(cuid())
  slug           String          @unique
  sku            String          @unique
  basePriceCents Int
  salePriceCents Int?
  currency       String          @default("EUR")
  unit           MeasurementUnit @default(WEIGHT)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  translations           ProductTranslation[]
  productCategories      ProductCategory[]
  variants               ProductVariant[]
  attributes             ProductAttribute[]
  images                 ProductImage[]
  trashedImages          ProductImageTrash[]
  slugAliases            ProductSlugAlias[]
  recommendations        ProductRecommendation[] @relation("RecommendationSource")
  recommendedBy          ProductRecommendation[] @relation("RecommendationTarget")
  stockNotifications     StockNotification[]
  googleAdsConfiguration GoogleAdsConfiguration?
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  locale           Locale
  name             String
  slug             String
  description      String?
  descriptionHtml  String?
  shortDescription String?
  seoTitle         String?
  metaDescription  String?
  promotionText    String?

  @@unique([productId, locale])
  @@unique([locale, slug])
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@index([categoryId, sortOrder])
  @@index([productId, isPrimary])
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id])
  sku            String      @unique
  priceCents     Int
  salePriceCents Int?
  stock          Int         @default(0)
  weightGrams    Int
  preparation    Preparation
  salting        Salting
  coating        Coating     @default(NONE)
  isActive       Boolean     @default(true)

  translations VariantTranslation[]
  orderItems   OrderItem[]

  @@index([productId])
}

model ProductSlugAlias {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale    Locale
  slug      String
  createdAt DateTime @default(now())

  @@unique([locale, slug])
  @@index([productId])
}

model ProductRecommendation {
  sourceProductId String
  sourceProduct   Product @relation("RecommendationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProductId String
  targetProduct   Product @relation("RecommendationTarget", fields: [targetProductId], references: [id], onDelete: Cascade)
  sortOrder       Int     @default(0)

  @@id([sourceProductId, targetProductId])
  @@unique([sourceProductId, sortOrder])
  @@index([targetProductId])
}

model StockNotification {
  id              String                  @id @default(cuid())
  productId       String
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  email           String
  emailNormalized String
  locale          Locale                  @default(nl)
  consentSource   String
  activeKey       String?                 @unique
  status          StockNotificationStatus @default(PENDING)
  createdAt       DateTime                @default(now())
  notifiedAt      DateTime?

  @@index([productId, status])
  @@index([emailNormalized])
}

model GoogleAdsConfiguration {
  id                   String          @id @default(cuid())
  productId            String          @unique
  product              Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  enabled              Boolean         @default(false)
  status               GoogleAdsStatus @default(DRAFT)
  headlines            String[]        @default([])
  descriptions         String[]        @default([])
  finalUrl             String?
  dailyBudgetMicros    Int?
  campaignResourceName String?
  adGroupResourceName  String?
  adResourceName       String?
  lastSyncedAt         DateTime?
  lastError            String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status])
}

model VariantTranslation {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  locale    Locale
  label     String

  @@unique([variantId, locale])
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  key       String
  value     String

  @@unique([productId, key])
  @@index([key, value])
  @@index([productId])
}

model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  storageKey String
  alt        String?
  sortOrder  Int     @default(0)
  isPrimary  Boolean @default(false)

  @@index([productId])
}

model ProductImageTrash {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  originalImageId    String
  originalStorageKey String
  archiveStorageKey  String   @unique
  alt                String?
  sortOrder          Int
  wasPrimary         Boolean  @default(false)
  deletedAt          DateTime @default(now())

  @@index([productId, deletedAt])
}

model Page {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations PageTranslation[]
}

model PageTranslation {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id])
  locale Locale
  title  String
  slug   String
  body   String

  @@unique([pageId, locale])
  @@unique([locale, slug])
}

model Article {
  id          String    @id @default(cuid())
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  translations ArticleTranslation[]
}

model ArticleTranslation {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id])
  locale    Locale
  title     String
  slug      String
  body      String

  @@unique([articleId, locale])
  @@unique([locale, slug])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  compositions Composition[]
}

model Order {
  id     String      @id @default(cuid())
  userId String
  user   User        @relation(fields: [userId], references: [id])
  status OrderStatus @default(PENDING)
  isTest Boolean     @default(false)

  locale        String  @default("nl")
  currency      String  @default("EUR")
  subtotalCents Int
  discountCode  String?
  discountCents Int     @default(0)
  shippingCents Int     @default(0)
  totalCents    Int

  contactName  String
  contactEmail String
  contactPhone String?

  deliveryMethod DeliveryMethod @default(SHIPPING)
  pickupLocationId String?

  shippingStreet      String?
  shippingHouseNumber String?
  shippingPostalCode  String?
  shippingCity        String?
  shippingCountry     String @default("NL")

  molliePaymentId String?   @unique
  paidAt          DateTime?

  postnlTrackingCode String?
  postnlLabelBase64  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  productName    String
  variantLabel   String
  quantity       Int
  unitPriceCents Int

  @@index([orderId])
  @@index([variantId])
}

model Composition {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  source    CompositionSource
  payload   Json
  createdAt DateTime          @default(now())

  @@index([userId])
}

// Runtime-editable admin config (e.g. PostNL account details) — unlike
// process.env, values here can be changed from /admin without a redeploy.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum AdminRole {
  OWNER
  ADMIN
  STAFF
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  auditEntries AuditLog[]
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

// Generic before/after snapshot log for every admin mutation. entityType is
// the Prisma model name (e.g. "Product", "QrCodeDesign"); entityId is that
// model's id as a string. Reverting replays `before` and writes a new
// RESTORE entry rather than mutating history in place.
model AuditLog {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  adminUserId String
  adminUser   AdminUser   @relation(fields: [adminUserId], references: [id])
  action      AuditAction
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  reverted    Boolean     @default(false)
  revertOfId  String?

  @@index([entityType, entityId])
  @@index([adminUserId])
  @@index([createdAt])
}

enum QrCodeTargetType {
  product
  category
  discount
  whatsapp
  email
  wifi
  url
  text
}

enum QrCodeStatus {
  active
  archived
}

model QrCodeDesign {
  id           String           @id @default(cuid())
  name         String
  status       QrCodeStatus     @default(active)
  targetType   QrCodeTargetType
  targetConfig Json
  designConfig Json
  labelConfig  Json
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

enum DiscountStatus {
  DRAFT
  ACTIVE
  SCHEDULED
  EXPIRED
}

model Discount {
  id             String         @id @default(cuid())
  code           String         @unique
  title          String
  subtitle       String?
  status         DiscountStatus @default(DRAFT)
  percentOff     Int?
  amountOffCents Int?
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum MarketingBannerPlacement {
  HOMEPAGE
  CATEGORY
  PROMOTION
}

model MarketingBanner {
  id        String                   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  placement MarketingBannerPlacement @default(HOMEPAGE)
  isActive  Boolean                  @default(true)
  sortOrder Int                      @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
}

enum MarketingCampaignStatus {
  DRAFT
  ACTIVE
  ENDED
}

model MarketingCampaign {
  id          String                  @id @default(cuid())
  title       String
  description String?
  status      MarketingCampaignStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

enum NewsletterCampaignStatus {
  DRAFT
  SCHEDULED
  SENT
}

model NewsletterCampaign {
  id          String                   @id @default(cuid())
  subject     String
  bodyHtml    String
  status      NewsletterCampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

enum NewsletterConsentStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  PENDING
  CLEANED
}

enum NewsletterConsentSource {
  CHECKOUT
  FORM
  MANUAL
  MAILCHIMP
}

model NewsletterConsent {
  id        String                  @id @default(cuid())
  email     String                  @unique
  firstName String?
  lastName  String?
  status    NewsletterConsentStatus @default(PENDING)
  optInAt   DateTime?
  optInIp   String?
  optOutAt  DateTime?
  source    NewsletterConsentSource
  locale    Locale
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([status, createdAt])
}

enum BusinessAccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model BusinessAccount {
  id          String                @id @default(cuid())
  companyName String
  contactName String
  email       String                @unique
  phone       String?
  vatNumber   String?
  status      BusinessAccountStatus @default(PENDING)
  priceTier   String                @default("standard")
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  quotes Quote[]
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

model Quote {
  id                String          @id @default(cuid())
  businessAccountId String
  businessAccount   BusinessAccount @relation(fields: [businessAccountId], references: [id])
  status            QuoteStatus     @default(DRAFT)
  items             Json
  totalCents        Int
  validUntil        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([businessAccountId])
}
