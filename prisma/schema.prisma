  priceTier            String                @default("standard")
  notes                String?
  loginLinkRequestedAt DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  quotes      Quote[]
  invitations BusinessInvitation[]
