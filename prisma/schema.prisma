  totalCents        Int
  validUntil        DateTime?
  sentAt            DateTime?
  approvedAt        DateTime?
  // Customer's preferred pickup day for this round's order - a plain
  // informational preference, not a hard gate on checkout. Day only, no
  // time (midnight local); the actual market schedule/colors live in
  // lib/market-schedule.ts.
  pickupDay         DateTime?
  deliveryStatus    String                  @default("NONE")
  providerMessageId String?
  deliveryError     String?
  deletedAt         DateTime?
  createdByAdminId  String
  createdByAdmin    AdminUser               @relation("BusinessOrderListCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  items                BusinessOrderListItem[]
  notes                BusinessOrderListNote[]
  events               BusinessEvent[]
  // A list is continuous/reusable: it accumulates one Order per checkout
  // round instead of being retired by its first payment.
  orders               Order[]
  cancellationRequests BusinessOrderCancellationRequest[]

  @@index([businessAccountId, createdAt])
  @@index([status, updatedAt])
}

model BusinessOrderListItem {
  id               String            @id @default(cuid())
  orderListId      String
  orderList        BusinessOrderList @relation(fields: [orderListId], references: [id], onDelete: Cascade)
  productVariantId String?
  productVariant   ProductVariant?   @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  productName      String
  variantLabel     String?
  sku              String?
  quantity         Int
  // Null exactly when priceOnRequest is true: the admin hasn't set a real
  // price yet and the customer sees "Prijs op aanvraag" instead of an
  // amount. Filling in unitPriceCents and clearing priceOnRequest is how an
  // admin resolves a price request.
  unitPriceCents   Int?
  priceOnRequest   Boolean           @default(false)
  // Set when the customer clicks "Vraag prijs aan" - lets the UI show
  // "Aangevraagd" instead of the button again, and stops a second click from
  // emailing the admin twice. Cleared automatically once an admin fills in
  // a real price (priceOnRequest goes back to false).
  priceRequestedAt DateTime?
  sortOrder        Int               @default(0)
  // Preserved across admin edits (not reset to "now" on every save) so the
  // customer portal can tell which items are genuinely new since the last
  // completed order, versus lines that were merely re-saved.
  createdAt        DateTime          @default(now())

  @@index([orderListId, sortOrder])
  @@index([productVariantId])
}

enum BusinessCancellationRequestStatus {
  PENDING
  PROCESSED
  REJECTED
}

model BusinessOrderCancellationRequest {
  id                String                            @id @default(cuid())
  businessAccountId String
  businessAccount   BusinessAccount                   @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  orderListId       String
  orderList         BusinessOrderList                 @relation(fields: [orderListId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order                             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status            BusinessCancellationRequestStatus @default(PENDING)
  reason            String?
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt

  items BusinessOrderCancellationRequestItem[]

  @@index([businessAccountId, createdAt])
  @@index([orderListId, createdAt])
  @@index([orderId, status])
}

model BusinessOrderCancellationRequestItem {
  requestId   String
  request     BusinessOrderCancellationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem                        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int

  @@id([requestId, orderItemId])
  @@index([orderItemId])
}

model BusinessOrderListNote {
  id          String            @id @default(cuid())
  orderListId String
  orderList   BusinessOrderList @relation(fields: [orderListId], references: [id], onDelete: Cascade)
  actorType   BusinessActorType
  authorName  String
  text        String            @db.Text
  createdAt   DateTime          @default(now())

  @@index([orderListId, createdAt])
}

model BusinessEvent {
  id                String              @id @default(cuid())
  businessAccountId String
  businessAccount   BusinessAccount     @relation(fields: [businessAccountId], references: [id], onDelete: Cascade)
  orderListId       String?
  orderList         BusinessOrderList?  @relation(fields: [orderListId], references: [id], onDelete: Cascade)
  type              BusinessEventType
  actorType         BusinessActorType
  actorName         String
  summary           String
  metadata          Json?
  createdAt         DateTime            @default(now())
  reads             BusinessEventRead[]

  @@index([businessAccountId, createdAt])
  @@index([orderListId, createdAt])
}

model BusinessEventRead {
  businessEventId String
  businessEvent   BusinessEvent @relation(fields: [businessEventId], references: [id], onDelete: Cascade)
  adminUserId     String
  adminUser       AdminUser     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  readAt          DateTime      @default(now())

  @@id([businessEventId, adminUserId])
  @@index([adminUserId, readAt])
}

enum InvoicePeppolStatus {
  NOT_APPLICABLE
  PENDING
  SENT
  FAILED
}

/**
 * One running counter per country, not per year: invoice numbers are built
 * as {countryCode}{counter} (e.g. NL0031, BE0032) so admin exports can
 * filter by country from the number alone.
 */
model InvoiceCounter {
  countryCode String @id
  lastNumber  Int    @default(0)
}

/**
 * One invoice per paid business Order, emailed to both the customer and Fedor.
 */
model Invoice {
  id                String              @id @default(cuid())
  invoiceNumber     String              @unique
  orderId           String              @unique
  order             Order               @relation(fields: [orderId], references: [id])
  businessAccountId String
  businessAccount   BusinessAccount     @relation(fields: [businessAccountId], references: [id])
  subtotalCents     Int
  vatRatePercent    Decimal             @db.Decimal(5, 2)
  vatRegime         BusinessVatRegime
  vatAmountCents    Int
  totalCents        Int
  currency          String              @default("EUR")
  invoiceNote       String?
  pdfBase64         String?             @db.Text
  peppolStatus      InvoicePeppolStatus @default(NOT_APPLICABLE)
  peppolMessageId   String?
  peppolSentAt      DateTime?
  peppolError       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([businessAccountId])
}
