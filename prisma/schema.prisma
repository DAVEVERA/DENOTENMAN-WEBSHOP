generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  nl
  en
  fr
}

enum CategoryType {
  STANDARD
  PROMOTIONAL
}

enum Preparation {
  RAW
  ROASTED
}

enum Salting {
  UNSALTED
  SALTED
}

enum Coating {
  NONE
  CHOCOLATE
  YOGHURT
  FLAVORED
}

enum MeasurementUnit {
  WEIGHT
  VOLUME
}

enum Role {
  OWNER
  ADMIN
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum AftersalesTrigger {
  ORDER_PAID
  ORDER_FULFILLED
}

enum AftersalesDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum EmailDeliveryKind {
  ORDER_CONFIRMATION
  ORDER_FULFILLED
  AFTERSALES_TEST
  BACK_IN_STOCK
  BUSINESS_ORDER_LIST
}

enum EmailDeliveryStatus {
  PENDING
  ACCEPTED
  DELIVERED
  BOUNCED
  COMPLAINED
  REJECTED
  SUPPRESSED
  FAILED
}

enum EmailDeliveryEventType {
  DELIVERED
  BOUNCED
  COMPLAINED
  REJECTED
  SUPPRESSED
}

enum EmailDeliveryAttemptStatus {
  STARTED
  ACCEPTED
  FAILED
}

enum DeliveryMethod {
  SHIPPING
  PICKUP
}

enum CompositionSource {
  TEXT
  VOICE
}

enum StockNotificationStatus {
  PENDING
  SENT
  CANCELLED
}

enum GoogleAdsStatus {
  DRAFT
  ENABLED
  PAUSED
  ERROR
}

enum ProductImageProcessingStatus {
  SUCCEEDED
  NEEDS_MANUAL_REVIEW
  FAILED
}

enum ProductFaqStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum ProductFaqPlacement {
  BELOW_DESCRIPTION
  BELOW_PRODUCT_DETAILS
  BEFORE_REVIEWS
  PAGE_BOTTOM
}

enum ProductFaqMediaType {
  IMAGE
  INFOGRAPHIC
  INSTRUCTION
}

enum DesignProvider {
  PHOTOROOM
  VMODEL
}

enum CostProvider {
  PHOTOROOM
  PRISMA
  OTHER
}

enum CostCategory {
  SOFTWARE
  INFRASTRUCTURE
  MARKETING
  OTHER
}

enum CostRecurrence {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum DesignJobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum DesignAssetStatus {
  DRAFT
  PUBLISHED
  DISCARDED
}

model Category {
  id        String       @id @default(cuid())
  slug      String       @unique
  type      CategoryType @default(STANDARD)
  parentId  String?
  parent    Category?    @relation("CategoryToChildren", fields: [parentId], references: [id])
  children  Category[]   @relation("CategoryToChildren")
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  translations      CategoryTranslation[]
  productCategories ProductCategory[]

  @@index([parentId])
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  locale      Locale
  name        String
  slug        String
  description String?

  @@unique([categoryId, locale])
  @@unique([locale, slug])
}

model Product {
  id             String          @id @default(cuid())
  slug           String          @unique
  sku            String          @unique
  basePriceCents Int
  salePriceCents Int?
  currency       String          @default("EUR")
  unit           MeasurementUnit @default(WEIGHT)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  translations           ProductTranslation[]
  productCategories      ProductCategory[]
  variants               ProductVariant[]
  attributes             ProductAttribute[]
  images                 ProductImage[]
  trashedImages          ProductImageTrash[]
  slugAliases            ProductSlugAlias[]
  recommendations        ProductRecommendation[] @relation("RecommendationSource")
  recommendedBy          ProductRecommendation[] @relation("RecommendationTarget")
  stockNotifications     StockNotification[]
  googleAdsConfiguration GoogleAdsConfiguration?
  faqSet                 ProductFaqSet?
  faqMediaAssets         ProductFaqMediaAsset[]
  designJobs             DesignJob[]
  designAssets           DesignAsset[]
  viewMetric             ProductViewMetric?
}

model ProductViewMetric {
  productId String   @id
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewCount Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([viewCount])
}

model ProductTranslation {
  id                   String  @id @default(cuid())
  productId            String
  product              Product @relation(fields: [productId], references: [id])
  locale               Locale
  name                 String
  slug                 String
  description          String?
  descriptionHtml      String?
  shortDescription     String?
  shortDescriptionHtml String?
  seoTitle             String?
  metaDescription      String?
  promotionText        String?

  @@unique([productId, locale])
  @@unique([locale, slug])
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@index([categoryId, sortOrder])
  @@index([productId, isPrimary])
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id])
  sku            String      @unique
  priceCents     Int
  salePriceCents Int?
  stock          Int         @default(0)
  weightGrams    Int
  preparation    Preparation
  salting        Salting
  coating        Coating     @default(NONE)
  isActive       Boolean     @default(true)

  translations           VariantTranslation[]
  orderItems             OrderItem[]
  businessOrderListItems BusinessOrderListItem[]

  @@index([productId])
}

model ProductSlugAlias {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale    Locale
  slug      String
  createdAt DateTime @default(now())

  @@unique([locale, slug])
  @@index([productId])
}

model ProductRecommendation {
  sourceProductId String
  sourceProduct   Product @relation("RecommendationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProductId String
  targetProduct   Product @relation("RecommendationTarget", fields: [targetProductId], references: [id], onDelete: Cascade)
  sortOrder       Int     @default(0)

  @@id([sourceProductId, targetProductId])
  @@unique([sourceProductId, sortOrder])
  @@index([targetProductId])
}

model StockNotification {
  id              String                  @id @default(cuid())
  productId       String
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  email           String
  emailNormalized String
  locale          Locale                  @default(nl)
  consentSource   String
  activeKey       String?                 @unique
  status          StockNotificationStatus @default(PENDING)
  createdAt       DateTime                @default(now())
  notifiedAt      DateTime?

  @@index([productId, status])
  @@index([emailNormalized])
}

model GoogleAdsConfiguration {
  id                   String          @id @default(cuid())
  productId            String          @unique
  product              Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  enabled              Boolean         @default(false)
  status               GoogleAdsStatus @default(DRAFT)
  headlines            String[]        @default([])
  descriptions         String[]        @default([])
  finalUrl             String?
  dailyBudgetMicros    Int?
  campaignResourceName String?
  adGroupResourceName  String?
  adResourceName       String?
  lastSyncedAt         DateTime?
  lastError            String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status])
}

model VariantTranslation {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  locale    Locale
  label     String

  @@unique([variantId, locale])
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  key       String
  value     String

  @@unique([productId, key])
  @@index([key, value])
  @@index([productId])
}

model ProductImage {
  id                    String                   @id @default(cuid())
  productId             String
  product               Product                  @relation(fields: [productId], references: [id])
  storageKey            String
  alt                   String?
  sortOrder             Int                      @default(0)
  isPrimary             Boolean                  @default(false)
  processingRecords     ProductImageProcessing[]
  sourceDesignJobs      DesignJob[]              @relation("DesignJobSourceImage")
  sourceDesignAssets    DesignAsset[]            @relation("DesignAssetSourceImage")
  publishedDesignAssets DesignAsset[]            @relation("DesignAssetPublishedImage")

  @@index([productId])
}

model ProductFaqSet {
  id                String   @id @default(cuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  aggregateRevision Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items     ProductFaqItem[]
  mutations ProductFaqMutation[]
}

model ProductFaqItem {
  id                  String              @id @default(cuid())
  faqSetId            String
  faqSet              ProductFaqSet       @relation(fields: [faqSetId], references: [id], onDelete: Cascade)
  status              ProductFaqStatus    @default(DRAFT)
  placement           ProductFaqPlacement @default(BELOW_PRODUCT_DETAILS)
  sortOrder           Int                 @default(0)
  version             Int                 @default(0)
  draftRevisionId     String?             @unique
  draftRevision       ProductFaqRevision? @relation("FaqDraftRevision", fields: [draftRevisionId], references: [id], onDelete: SetNull)
  publishedRevisionId String?             @unique
  publishedRevision   ProductFaqRevision? @relation("FaqPublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  revisions ProductFaqRevision[] @relation("FaqItemRevisions")

  @@index([faqSetId, deletedAt, placement, sortOrder])
  @@index([faqSetId, status, placement, sortOrder])
}

model ProductFaqRevision {
  id           String                @id @default(cuid())
  itemId       String
  item         ProductFaqItem        @relation("FaqItemRevisions", fields: [itemId], references: [id], onDelete: Cascade)
  revision     Int
  mediaAssetId String?
  mediaAsset   ProductFaqMediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    AdminUser             @relation(fields: [createdById], references: [id])
  createdAt    DateTime              @default(now())

  translations      ProductFaqTranslation[]
  draftForItems     ProductFaqItem[]        @relation("FaqDraftRevision")
  publishedForItems ProductFaqItem[]        @relation("FaqPublishedRevision")

  @@unique([itemId, revision])
  @@index([mediaAssetId])
}

model ProductFaqTranslation {
  id         String             @id @default(cuid())
  revisionId String
  revision   ProductFaqRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  locale     Locale
  question   String
  answerHtml String             @db.Text
  mediaLabel String?

  @@unique([revisionId, locale])
}

model ProductFaqMediaAsset {
  id               String              @id @default(cuid())
  productId        String
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  type             ProductFaqMediaType
  storageKey       String              @unique
  originalFilename String
  contentType      String
  fileSize         Int
  width            Int?
  height           Int?
  pageCount        Int?
  durationMs       Int?
  createdAt        DateTime            @default(now())
  deletedAt        DateTime?

  revisions ProductFaqRevision[]

  @@index([productId, deletedAt])
}

model ProductFaqMutation {
  id             String        @id @default(cuid())
  faqSetId       String
  faqSet         ProductFaqSet @relation(fields: [faqSetId], references: [id], onDelete: Cascade)
  idempotencyKey String
  operation      String
  requestHash    String
  itemId         String?
  createdAt      DateTime      @default(now())

  @@unique([faqSetId, idempotencyKey])
  @@index([createdAt])
}

model DesignJob {
  id                     String          @id @default(cuid())
  productId              String
  product                Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceImageId          String
  sourceImage            ProductImage    @relation("DesignJobSourceImage", fields: [sourceImageId], references: [id])
  requestedByAdminUserId String
  requestedByAdminUser   AdminUser       @relation(fields: [requestedByAdminUserId], references: [id])
  idempotencyKey         String          @unique
  provider               DesignProvider  @default(PHOTOROOM)
  status                 DesignJobStatus @default(QUEUED)
  options                Json
  providerRequestId      String?
  errorCode              String?
  errorMessage           String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  assets DesignAsset[]

  @@index([productId, createdAt])
  @@index([status, createdAt])
}

model DesignAsset {
  id             String            @id @default(cuid())
  jobId          String
  job            DesignJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceImageId  String
  sourceImage    ProductImage      @relation("DesignAssetSourceImage", fields: [sourceImageId], references: [id])
  storageKey     String            @unique
  contentType    String
  width          Int
  height         Int
  fileSize       Int
  status         DesignAssetStatus @default(DRAFT)
  productImageId String?           @unique
  productImage   ProductImage?     @relation("DesignAssetPublishedImage", fields: [productImageId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([productId, status, createdAt])
}

model DesignProviderUsage {
  id        String         @id @default(cuid())
  dayKey    String
  provider  DesignProvider
  attempts  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([dayKey, provider])
}

model ProductImageProcessing {
  id                 String                       @id @default(cuid())
  productImageId     String
  productImage       ProductImage                 @relation(fields: [productImageId], references: [id], onDelete: Cascade)
  originalStorageKey String
  sourceSha256       String?
  sourceGeneration   String?
  status             ProductImageProcessingStatus
  processingVersion  String
  runId              String
  masterWebpKey      String?
  thumbnailWebpKey   String?
  thumbnailAvifKey   String?
  cardWebpKey        String?
  cardAvifKey        String?
  productWebpKey     String?
  productAvifKey     String?
  detectedCenterX    Float?
  detectedCenterY    Float?
  detectedRadius     Float?
  detectedConfidence Float?
  marginRatio        Float?
  cropLeft           Int?
  cropTop            Int?
  cropSize           Int?
  errorCode          String?
  errorMessage       String?
  details            Json?
  attemptedAt        DateTime                     @default(now())
  processedAt        DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@unique([productImageId, processingVersion])
  @@index([status, processingVersion])
  @@index([processingVersion, sourceSha256])
}

model ProductImageTrash {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  originalImageId    String
  originalStorageKey String
  archiveStorageKey  String   @unique
  alt                String?
  sortOrder          Int
  wasPrimary         Boolean  @default(false)
  deletedAt          DateTime @default(now())

  @@index([productId, deletedAt])
}

model Page {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations PageTranslation[]
}

model PageTranslation {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id])
  locale Locale
  title  String
  slug   String
  body   String

  @@unique([pageId, locale])
  @@unique([locale, slug])
}

model Article {
  id          String    @id @default(cuid())
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  translations ArticleTranslation[]
}

model ArticleTranslation {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id])
  locale    Locale
  title     String
  slug      String
  body      String

  @@unique([articleId, locale])
  @@unique([locale, slug])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  compositions Composition[]
}

model Order {
  id     String      @id @default(cuid())
  userId String
  user   User        @relation(fields: [userId], references: [id])
  status OrderStatus @default(PENDING)
  isTest Boolean     @default(false)

  locale        String  @default("nl")
  currency      String  @default("EUR")
  subtotalCents Int
  discountCode  String?
  discountCents Int     @default(0)
  shippingCents Int     @default(0)
  totalCents    Int

  contactName  String
  contactEmail String
  contactPhone String?

  deliveryMethod   DeliveryMethod @default(SHIPPING)
  pickupLocationId String?

  shippingStreet      String?
  shippingHouseNumber String?
  shippingPostalCode  String?
  shippingCity        String?
  shippingCountry     String  @default("NL")

  molliePaymentId String?   @unique
  paidAt          DateTime?

  postnlTrackingCode    String?
  postnlLabelBase64     String?   @db.Text
  postnlLabelClaimToken String?
  postnlLabelClaimedAt  DateTime?
  postnlLabelLastError  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                OrderItem[]
  refunds              OrderRefund[]
  aftersalesDeliveries AftersalesDelivery[]
  emailDeliveryLogs    EmailDeliveryLog[]

  @@index([userId])
  @@index([status])
}

model AftersalesFlow {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps AftersalesStep[]
}

model AftersalesStep {
  id           String            @id @default(cuid())
  flowId       String
  flow         AftersalesFlow    @relation(fields: [flowId], references: [id], onDelete: Cascade)
  trigger      AftersalesTrigger
  name         String
  position     Int
  enabled      Boolean           @default(true)
  delayMinutes Int               @default(0)
  content      Json
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  deliveries AftersalesDelivery[]

  @@unique([flowId, trigger])
  @@index([flowId, position])
}

model AftersalesDelivery {
  id                String                   @id @default(cuid())
  orderId           String
  order             Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stepId            String
  step              AftersalesStep           @relation(fields: [stepId], references: [id], onDelete: Cascade)
  trigger           AftersalesTrigger
  status            AftersalesDeliveryStatus @default(PENDING)
  provider          String?
  providerMessageId String?
  attempts          Int                      @default(0)
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([orderId, stepId, trigger])
  @@index([status, createdAt])
  @@index([orderId, createdAt])
}

model EmailDeliveryLog {
  id                  String              @id @default(cuid())
  idempotencyKey      String              @unique
  kind                EmailDeliveryKind
  status              EmailDeliveryStatus @default(PENDING)
  recipientEmail      String
  recipientName       String?
  subject             String
  htmlBody            String              @db.Text
  textBody            String              @db.Text
  provider            String?
  providerMessageId   String?
  providerStatus      String?
  orderId             String?
  order               Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  trigger             AftersalesTrigger?
  errorCode           String?
  errorMessage        String?
  acceptedAt          DateTime?
  deliveredAt         DateTime?
  bouncedAt           DateTime?
  complainedAt        DateTime?
  lastProviderEventAt DateTime?
  lastAttemptAt       DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  attempts EmailDeliveryAttempt[]
  events   EmailDeliveryEvent[]

  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([orderId, createdAt])
  @@index([recipientEmail, createdAt])
  @@index([providerMessageId])
}

model EmailDeliveryAttempt {
  id                String                     @id @default(cuid())
  deliveryId        String
  delivery          EmailDeliveryLog           @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  provider          String
  status            EmailDeliveryAttemptStatus @default(STARTED)
  providerMessageId String?
  providerStatus    String?
  errorCode         String?
  errorMessage      String?
  startedAt         DateTime                   @default(now())
  completedAt       DateTime?

  @@unique([deliveryId, attemptNumber])
  @@index([status, startedAt])
}

model EmailDeliveryEvent {
  id                String                 @id @default(cuid())
  providerEventId   String                 @unique
  deliveryId        String
  delivery          EmailDeliveryLog       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  provider          String
  providerMessageId String
  type              EmailDeliveryEventType
  providerEvent     String
  reasonCode        String?
  occurredAt        DateTime
  createdAt         DateTime               @default(now())

  @@index([deliveryId, occurredAt])
  @@index([type, occurredAt])
  @@index([providerMessageId])
}

model OrderItem {
  id             String            @id @default(cuid())
  orderId        String
  order          Order             @relation(fields: [orderId], references: [id])
  variantId      String
  variant        ProductVariant    @relation(fields: [variantId], references: [id])
  productName    String
  variantLabel   String
  quantity       Int
  unitPriceCents Int
  refundItems    OrderRefundItem[]

  @@index([orderId])
  @@index([variantId])
}

enum OrderRefundStatus {
  CREATING
  QUEUED
  PENDING
  PROCESSING
  REFUNDED
  FAILED
  CANCELED
}

model OrderRefund {
  id                     String            @id @default(cuid())
  orderId                String
  order                  Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedByAdminUserId String
  requestedByAdminUser   AdminUser         @relation(fields: [requestedByAdminUserId], references: [id])
  mollieRefundId         String?           @unique
  idempotencyKey         String            @unique
  amountCents            Int
  reason                 String?
  includesShipping       Boolean           @default(false)
  status                 OrderRefundStatus @default(CREATING)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  items OrderRefundItem[]

  @@index([orderId, status])
  @@index([requestedByAdminUserId])
}

model OrderRefundItem {
  refundId         String
  refund           OrderRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItemId      String
  orderItem        OrderItem   @relation(fields: [orderItemId], references: [id])
  quantity         Int
  grossAmountCents Int

  @@id([refundId, orderItemId])
  @@index([orderItemId])
}

model Composition {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  source    CompositionSource
  payload   Json
  createdAt DateTime          @default(now())

  @@index([userId])
}

// Runtime-editable admin config (e.g. PostNL account details) — unlike
// process.env, values here can be changed from /admin without a redeploy.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum AdminRole {
  OWNER
  ADMIN
  STAFF
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  auditEntries         AuditLog[]
  requestedRefunds     OrderRefund[]
  faqRevisions         ProductFaqRevision[]
  designJobs           DesignJob[]
  createdManagedCosts  ManagedCost[]        @relation("ManagedCostCreatedBy")
  updatedManagedCosts  ManagedCost[]        @relation("ManagedCostUpdatedBy")
  deletedManagedCosts  ManagedCost[]        @relation("ManagedCostDeletedBy")
  uploadedCostInvoices CostInvoice[]        @relation("CostInvoiceUploadedBy")
  deletedCostInvoices  CostInvoice[]        @relation("CostInvoiceDeletedBy")
  costMutations        CostMutation[]
  businessInvitations  BusinessInvitation[] @relation("BusinessInvitationCreatedBy")
  businessOrderLists   BusinessOrderList[]  @relation("BusinessOrderListCreatedBy")
  businessEventReads   BusinessEventRead[]
}

model ManagedCost {
  id                   String         @id @default(uuid()) @db.Uuid
  provider             CostProvider
  providerName         String
  category             CostCategory
  description          String?
  amountCents          Int?
  currency             String         @default("EUR")
  recurrence           CostRecurrence
  startsAt             DateTime?
  endsAt               DateTime?
  active               Boolean        @default(true)
  version              Int            @default(1)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?
  createdByAdminUserId String?
  createdBy            AdminUser?     @relation("ManagedCostCreatedBy", fields: [createdByAdminUserId], references: [id], onDelete: SetNull)
  updatedByAdminUserId String?
  updatedBy            AdminUser?     @relation("ManagedCostUpdatedBy", fields: [updatedByAdminUserId], references: [id], onDelete: SetNull)
  deletedByAdminUserId String?
  deletedBy            AdminUser?     @relation("ManagedCostDeletedBy", fields: [deletedByAdminUserId], references: [id], onDelete: SetNull)

  invoices CostInvoice[]

  @@index([deletedAt, active, provider])
  @@index([category, deletedAt])
}

model CostInvoice {
  id                    String        @id @default(uuid()) @db.Uuid
  managedCostId         String?       @db.Uuid
  managedCost           ManagedCost?  @relation(fields: [managedCostId], references: [id], onDelete: SetNull)
  provider              CostProvider?
  category              CostCategory?
  amountCents           Int?
  currency              String        @default("EUR")
  issuedAt              DateTime
  billingPeriodStart    DateTime?
  billingPeriodEnd      DateTime?
  originalFilename      String
  contentType           String
  fileSize              Int
  sha256                String
  storageKey            String        @unique
  notes                 String?
  version               Int           @default(1)
  uploadedByAdminUserId String
  uploadedBy            AdminUser     @relation("CostInvoiceUploadedBy", fields: [uploadedByAdminUserId], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?
  deletedByAdminUserId  String?
  deletedBy             AdminUser?    @relation("CostInvoiceDeletedBy", fields: [deletedByAdminUserId], references: [id], onDelete: SetNull)

  @@index([deletedAt, issuedAt])
  @@index([managedCostId, deletedAt])
  @@index([provider, issuedAt])
}

model CostMutation {
  id             String    @id @default(uuid()) @db.Uuid
  adminUserId    String
  adminUser      AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  idempotencyKey String
  operation      String
  requestHash    String
  entityType     String
  entityId       String
  response       Json
  createdAt      DateTime  @default(now())

  @@unique([adminUserId, idempotencyKey])
  @@index([createdAt])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

// Generic before/after snapshot log for every admin mutation. entityType is
// the Prisma model name (e.g. "Product", "QrCodeDesign"); entityId is that
// model's id as a string. Reverting replays `before` and writes a new
// RESTORE entry rather than mutating history in place.
model AuditLog {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  adminUserId String
  adminUser   AdminUser   @relation(fields: [adminUserId], references: [id])
  action      AuditAction
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  reverted    Boolean     @default(false)
  revertOfId  String?

  @@index([entityType, entityId])
  @@index([adminUserId])
  @@index([createdAt])
}

