# ==============================================================================
# DeNotenman — environment template
# Copy to .env and fill in. Never commit .env.
# ==============================================================================

# --- Runtime ---
NODE_ENV=development

# --- API ---
PORT=3001

# --- Worker ---
WORKER_PORT=3002

# --- Database ---
DATABASE_URL=postgresql://denotenman:denotenman@localhost:5432/denotenman?schema=public

# --- Redis (BullMQ) ---
# Required for the worker at all times. Optional for the API in development.
REDIS_URL=redis://localhost:6379

# --- App URLs ---
# Required in production. In development localhost defaults apply if omitted.
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3003
API_URL=http://localhost:3001

# --- Auth ---
# Minimum 32 random bytes each. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_32_BYTES_BASE64_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_32_BYTES_BASE64_REFRESH
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CSRF_SECRET=CHANGE_ME_32_BYTES_BASE64_CSRF

# --- Stripe ---
# STRIPE_SECRET_KEY — required in production, optional in development/preview.
# Use test-mode keys (sk_test_...) locally; never commit real keys.  # production only
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET — required when STRIPE_SECRET_KEY is set.    # production only
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Observability ---
# SENTRY_DSN — server-side DSN (Node.js / Edge runtimes).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# NEXT_PUBLIC_SENTRY_DSN — client-side DSN; DSNs are public-by-design (ADR 0011).
# Can share the same value as SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN — build-time only; never exposed at runtime.
# Used by withSentryConfig to upload source maps; omit in dev to skip upload.
SENTRY_AUTH_TOKEN=
# Source-map upload targets — optional in dev, required in CI for upload.
SENTRY_ORG=
SENTRY_PROJECT_STOREFRONT=
SENTRY_PROJECT_ADMIN=

# --- Storage (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=denotenman-media
R2_PUBLIC_URL=

# --- Mail ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DeNotenman <no-reply@denotenman.nl>"

# --- Argon2 (password hashing) ---
ARGON2_MEMORY_COST=47104
ARGON2_TIME_COST=3

# --- Seed (development only) ---
SEED_OWNER_EMAIL=owner@denotenman.nl
SEED_OWNER_PASSWORD=
SEED_ADMIN_EMAIL=admin@denotenman.nl
SEED_ADMIN_PASSWORD=
