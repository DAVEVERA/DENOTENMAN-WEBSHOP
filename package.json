{
  "name": "denotenman-webshop",
  "version": "0.1.0",
  "private": true,
  "author": "MNRV",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/check-database-access.cjs development && next dev",
    "build": "node scripts/check-database-access.cjs build && prisma generate && next build",
    "start": "node scripts/check-database-access.cjs runtime && next start",
    "email": "email dev --dir emails --port 3010",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/check-database-access.cjs migrate-development && prisma migrate dev",
    "prisma:seed": "node scripts/check-database-access.cjs seed && tsx prisma/seed.ts",
    "images:migrate": "tsx scripts/migrate-product-images.ts",
    "images:verify": "tsx scripts/verify-product-image-migration.ts",
    "faqs:migrate": "tsx scripts/migrate-product-faqs.ts",
    "photoroom:smoke": "tsx scripts/run-photoroom-smoke.ts",
    "test:product-faqs": "tsx --test tests/product-faq-*.test.ts tests/product-faq-*.test.tsx",
    "test:product-images": "tsx --test tests/product-image-migration*.test.ts",
    "test:transactional-email": "node scripts/run-transactional-email-tests.cjs",
    "seo:fix-french-slugs": "tsx scripts/fix-french-slugs.ts",
    "catalog:sync-menu-taxonomy": "tsx scripts/sync-menu-taxonomy.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.44",
    "@google-cloud/storage": "5.18.3",
    "@google-cloud/translate": "^9.4.2",
    "@google/genai": "2.17.1",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@mollie/api-client": "^4.6.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "6.12.0",
    "ai": "^7.0.66",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "googleapis": "^174.0.1",
    "lucide-react": "^1.30.0",
    "next": "^16.3.0",
    "p-limit": "^7.3.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "qr-code-styling": "^1.9.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-email": "^6.9.2",
    "resend": "^6.20.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@react-email/ui": "^6.9.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@types/mailchimp__mailchimp_marketing": "^3.0.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "6.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "teeny-request": {
      "uuid": "11.1.1"
    }
  }
}
