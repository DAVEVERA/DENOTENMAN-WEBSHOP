# Image for the product image migration Cloud Run job.
#
# Deliberately separate from the storefront Dockerfile: this image runs a
# batch script, not a server. It needs tsx, Prisma Client, sharp and the
# OpenCV WebAssembly build, but no `next build`, no Playwright and no static
# assets — and keeping it apart means the live storefront build path is never
# touched to change how the migration runs.
FROM node:22-slim AS base
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# tsx and the migration's analysis dependencies are devDependencies, so the
# default (non-production) install is what this image needs.
RUN npm ci

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
# tsconfig carries the "@/*" path alias that lib/ imports resolve through.
COPY package.json package-lock.json tsconfig.json ./
COPY prisma ./prisma
COPY lib ./lib
COPY scripts ./scripts

RUN npx prisma generate

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs migrator
USER migrator

# Writes only under the derived namespace and the ledger; a bare execution is a
# dry run, because the entrypoint requires a confirmation token to apply.
ENTRYPOINT ["node", "--import", "tsx", "scripts/ops/image-migration-job.ts"]
